---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout
  title="404: Route Not Found | Ahsan Ahmad Siddiqui"
  description="The requested route does not exist."
>
  <Header />

  <main id="main-content" class="flex-grow flex items-center justify-center py-24 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full text-center space-y-6 p-8 rounded-2xl bg-bg-surface border border-border-subtle">
      <div class="font-mono text-xs text-accent uppercase tracking-widest">ERROR 404</div>
      <h1 class="font-display text-4xl font-bold text-text-primary tracking-tight">
        Route Not Found
      </h1>
      <p class="text-sm text-text-secondary leading-relaxed font-mono">
        The requested system path does not resolve to an active service endpoint.
      </p>
      <div class="pt-4">
        <a
          href={baseUrl}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-accent text-zinc-950 font-mono text-xs font-bold hover:opacity-90 btn-press transition-opacity shadow-sm"
        >
          <span>&larr; Return to System Overview</span>
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
