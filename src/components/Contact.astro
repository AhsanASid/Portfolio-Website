---
const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const resumePath = `${baseUrl}resume/Ahsan-Ahmad-Siddiqui-Resume.pdf`;
---

<section id="contact" class="py-20 md:py-28 bg-bg-base border-b border-border-subtle">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto space-y-12 text-center sm:text-left">
      <!-- Section Header -->
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 font-mono text-xs text-accent">
          <span>08</span>
          <span class="w-8 h-[1px] bg-accent/40"></span>
          <span class="tracking-widest uppercase">CONTACT &amp; AVAILABILITY</span>
        </div>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-text-primary">
          Let's Build Reliable Systems.
        </h2>
        <p class="text-base sm:text-lg text-text-secondary max-w-2xl leading-relaxed">
          Open to Associate / Junior DevOps &amp; Cloud Infrastructure opportunities, Systems Operations, Automation &amp; Junior SRE positions, and Early-Career Infrastructure-focused Software Engineering roles.
        </p>
      </div>

      <!-- Action Box -->
      <div class="p-6 sm:p-8 rounded-2xl bg-bg-surface border border-border-subtle shadow-sm space-y-6">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-6 pb-6 border-b border-border-subtle">
          <div class="space-y-1 text-center sm:text-left">
            <div class="text-xs font-mono text-text-tertiary uppercase">Primary Direct Dispatch</div>
            <div class="text-xl sm:text-2xl font-mono font-bold text-text-primary tracking-tight">
              ahsansid001@gmail.com
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <button
              type="button"
              id="contact-copy-btn"
              data-email="ahsansid001@gmail.com"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-bg-subtle border border-border-subtle hover:border-border-active text-text-primary font-mono text-xs font-semibold btn-press transition-colors focus:outline-none"
              aria-label="Copy email address"
            >
              <svg class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
              <span id="contact-copy-text">Copy Email</span>
            </button>

            <a
              href="mailto:ahsansid001@gmail.com"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-accent text-zinc-950 font-mono text-xs font-bold hover:opacity-90 btn-press transition-opacity shadow-sm"
            >
              <span>Send Mail ↗</span>
            </a>
          </div>
        </div>

        <!-- Secondary Channels & Resume Download -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
          <a
            href="https://www.linkedin.com/in/ahsan-ahmad-siddiqui-594120201/"
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 rounded-xl bg-bg-subtle/50 hover:bg-bg-subtle border border-border-subtle/60 transition-colors flex items-center justify-between group"
          >
            <div>
              <div class="text-[11px] font-mono text-text-tertiary uppercase">Professional Network</div>
              <div class="text-sm font-semibold text-text-primary group-hover:text-accent transition-colors">LinkedIn Profile</div>
            </div>
            <span class="text-accent text-sm font-mono">↗</span>
          </a>

          <a
            href="https://github.com/AhsanASid"
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 rounded-xl bg-bg-subtle/50 hover:bg-bg-subtle border border-border-subtle/60 transition-colors flex items-center justify-between group"
          >
            <div>
              <div class="text-[11px] font-mono text-text-tertiary uppercase">Open Source &amp; Code</div>
              <div class="text-sm font-semibold text-text-primary group-hover:text-accent transition-colors">GitHub Profile</div>
            </div>
            <span class="text-accent text-sm font-mono">↗</span>
          </a>

          <a
            href={resumePath}
            download="Ahsan-Ahmad-Siddiqui-Resume.pdf"
            class="p-4 rounded-xl bg-bg-subtle/50 hover:bg-bg-subtle border border-border-subtle/60 transition-colors flex items-center justify-between group"
          >
            <div>
              <div class="text-[11px] font-mono text-text-tertiary uppercase">Curriculum Vitae</div>
              <div class="text-sm font-semibold text-text-primary group-hover:text-accent transition-colors">Download PDF</div>
            </div>
            <span class="text-accent text-sm font-mono">↓</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Footer Colophon -->
<footer class="py-8 bg-bg-surface border-t border-border-subtle">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-text-tertiary">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-accent"></span>
      <span class="text-text-secondary">&copy; 2026 Ahsan Ahmad Siddiqui.</span>
      <span>Engineered with reliability and precision.</span>
    </div>

    <div class="flex items-center gap-4">
      <a href="#about" class="hover:text-text-primary transition-colors">Top &uarr;</a>
      <span>·</span>
      <span>Bengaluru, India (IST)</span>
    </div>
  </div>
</footer>

<script>
  // Copy Email Handler
  const contactCopyBtn = document.getElementById('contact-copy-btn');
  const contactCopyText = document.getElementById('contact-copy-text');
  contactCopyBtn?.addEventListener('click', async () => {
    const email = contactCopyBtn.getAttribute('data-email') || 'ahsansid001@gmail.com';
    try {
      await navigator.clipboard.writeText(email);
      if (contactCopyText) {
        contactCopyText.innerText = 'Email Copied!';
        setTimeout(() => {
          contactCopyText.innerText = 'Copy Email';
        }, 2200);
      }
    } catch (err) {
      window.location.href = `mailto:${email}`;
    }
  });
</script>
