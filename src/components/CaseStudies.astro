            <!-- Quantified Metrics Callout -->
            <div class="grid grid-cols-3 gap-2 p-3 rounded-xl bg-bg-subtle border border-border-subtle text-center">
              <div>
                <div class="font-mono text-xl sm:text-2xl font-bold text-accent tabular-nums">50+ hrs</div>
                <div class="text-[10px] text-text-tertiary uppercase font-mono">Monthly Toil Saved</div>
